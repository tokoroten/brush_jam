# Copy to .env at the repo root. Values here are read at startup and never
# logged. A variable already set in the environment wins over this file, so
# `pnpm dev:stream` still overrides AI_BACKEND below.

# Pin the backend instead of relying on which script you launched. Recommended
# for a playtest: the stream worker is the fast one (see README, Playtest
# quickstart). Values: auto | stream | comfyui | mock | runpod
# AI_BACKEND=stream

# Everything else is optional; see the environment variable table in README.md.
# AI_WINDOW=768
# AI_DENOISE=0.8
# HOST=0.0.0.0

# Secrets, if you use the RunPod backend. Never commit a filled-in .env.
# RUNPOD_ENDPOINT_ID=
# RUNPOD_API_KEY=

# Brush Jam configuration. Copy to .env and edit; .env is gitignored.
#
#     cp .env.example .env
#
# Only INPROC_CHECKPOINT has to be set to run with a local GPU. Everything
# below has a working default, and every value here IS the default unless the
# comment says otherwise.


# ---------------------------------------------------------------- the server

# 127.0.0.1 is this machine only. Use 0.0.0.0 to let friends on your LAN join.
HOST=127.0.0.1
PORT=8787
# World size in pixels, square. The canvas everyone draws on.
CANVAS_SIZE=1024


# ------------------------------------------------------------------- backend

# Where generation happens:
#   inproc   the model lives in this process (one GPU, fastest, the normal one)
#   stream   a separate worker process, possibly on another machine
#   comfyui  a running ComfyUI instance
#   runpod   a RunPod serverless endpoint
#   mock     no model at all: instant grey results, for development
#   auto     inproc if a checkpoint is configured, else comfyui, else mock
#
# Only `auto` falls back. `inproc` without torch or without a checkpoint is a
# startup error, on purpose: an explicit choice that cannot be honoured should
# not turn into a room quietly running the mock. With no GPU, set this to mock.
AI_BACKEND=inproc


# --------------------------------------------------------------- the model
#
# Required for AI_BACKEND=inproc. Any SDXL .safetensors works; the numbers in
# docs/ were measured with an Illustrious-based one. To download it:
#
#   uv run --project apps/brushjam python apps/brushjam/scripts/download_models.py
#
# which prints the line to paste here.
INPROC_CHECKPOINT=

# Where the 4-step LoRA and the VAE are downloaded to (created on demand).
INPROC_LORA_DIR=./models/loras
# The few-step LoRA used by the `fast` profile: dmd2 or lcm.
INPROC_LORA=dmd2
# fp16fix (rescaled, correct in fp16), taesd (much faster, softer), or
# checkpoint (the model's own, which forces fp32 and is slow).
INPROC_VAE=fp16fix
# Decode in tiles: slower, but it is what keeps 1024 inside 8 GB.
INPROC_VAE_TILING=true
# Tile edge in pixels, or auto. diffusers only tiles an image LARGER than this
# and its own default is 1024, so out of the box nothing at 768 or 1024 is
# tiled at all. auto = 256 on a card under 12 GB, which is the single biggest
# win on an 8 GB one: 2.2 s an edit at 768 instead of 6.7 (docs/PYTHON_SERVER.md,
# "8 GB cards"). 0 leaves the library's default alone.
INPROC_VAE_TILE_SIZE=auto
# How the UNet's weights are stored: fp16, fp8, or auto (fp8 below 7 GB).
# fp8 is diffusers' layerwise casting - 2.4 GB less resident, at the cost of
# ~1.2 s an edit at 768, because the weights are cast as they run and the LoRA
# can no longer be fused. Worth it when something else needs the card.
INPROC_UNET_STORAGE=auto
# Hand fragmented VRAM back immediately before the VAE decode. Measured as
# neither better nor worse once the decode is tiled; here for a card where it
# is not.
INPROC_EMPTY_CACHE_BEFORE_DECODE=false
# Largest generation this machine will attempt.
INPROC_MAX_SIZE=1024
# Denoise ceiling; above this an img2img stops being a reinterpretation.
INPROC_MAX_DENOISE=0.9
# Size the model is warmed up at during startup.
INPROC_WARMUP_SIZE=768
# Keep the text encoders on the CPU (~1.8 GB of VRAM back on an 8 GB card).
INPROC_OFFLOAD_TEXT_ENCODERS=true
# Release fragmented VRAM after every generation.
INPROC_EMPTY_CACHE=true
# How many prompt embeddings to cache.
INPROC_EMBED_CACHE=16
# Load the model at startup rather than on the first stroke. Set to 1 to defer.
INPROC_NO_PRELOAD=
# Serve the whole protocol with no model at all (the pipeline echoes its input).
INPROC_DRY_RUN=


# ---------------------------------------------------------------- generation

# Generation size in px; the result is scaled back onto the canvas. The room
# can change this at runtime, up to the backend's maximum.
AI_WINDOW=768
# Which profile a new room starts on: fast (4 steps) or quality (14 steps).
AI_PROFILE=fast
# img2img strength. Higher reinterprets more and follows the drawing less.
# The inproc and stream backends start a room at 0.8 instead, where their
# 4-step LoRA needs it; this is the value for the others.
AI_DENOISE=0.7
# Steps for the quality profile.
AI_STEPS=14
# Steps for the fast profile. The DMD2 LoRA is distilled for 4.
AI_FAST_STEPS=4
# How long after the last stroke a generation starts.
AI_DEBOUNCE_MS=400
# A generation taking longer than this is abandoned.
AI_WATCHDOG_MS=180000
# ComfyUI only: classifier-free guidance and VAE tile size (0 = no tiling).
AI_CFG=5.5
AI_VAE_TILE=0


# ------------------------------------------------------------------ presets

# Whether the preset picker offers the R18 group. Off by default.
#
# This is a gate on the MENU, not on the room: the server accepts any prompt
# from any client either way, because a prompt is a prompt and there is nothing
# here that could tell one from another. It exists so that a room of people who
# did not ask for that are not picking from a list that contains it.
PRESETS_R18=0


# ------------------------------------------------------- saving and history
#
# Every accepted AI result is also written to disk as a JPEG plus a small JSON
# entry, and served back by GET /rooms/{id}/history - which is what the
# "history" button in the room shows. It outlives the room and the process.

# Set to 0 to keep nothing at all.
HISTORY_ENABLED=1
# Where the JPEGs go, relative to the working directory (data/ is gitignored).
HISTORY_DIR=./data/history
# Budgets, in megabytes. Whichever is reached first evicts oldest first.
HISTORY_ROOM_MB=200
HISTORY_TOTAL_MB=2000


# ------------------------------------------------------------------- limits
#
# Every player behind the same address shares these counters - and behind the
# RunPod proxy that means everyone, which is why the pod raises the first one.

# New rooms per minute per client IP.
ROOM_CREATE_PER_MIN=10
# An empty room is reclaimed after this long.
ROOM_IDLE_MS=1800000
# A room nobody ever joined is dropped sooner.
UNJOINED_ROOM_TTL_MS=300000
# Connections per room, and across the whole server.
MAX_ROOM_SOCKETS=16
MAX_TOTAL_SOCKETS=256
# A room's stroke log, in points and in serialised bytes.
MAX_ROOM_POINTS=2000000
MAX_ROOM_SNAPSHOT_BYTES=6291456


# --------------------------------------------------- deploying to a RunPod pod
#
# See docs/RUNPOD_POD.md. Secrets: never commit these.

RUNPOD_API_KEY=
# For downloading the checkpoint into the pod (and by download_models.py).
CIVITAI_TOKEN=
CIVITAI_VERSION=2167369
# Hugging Face, for the LoRA and the VAE. A read-only token is enough.
HF_TOKEN=


# --------------------------------------------------------- the other backends

# AI_BACKEND=stream: a worker process (apps/stream-worker), local or remote.
STREAM_URL=http://127.0.0.1:8790
STREAM_TIMEOUT_MS=120000
# Let `auto` choose a warm worker. Off by default: a worker answering only
# means it is holding VRAM, which is a deployment decision, not a preference.
AI_STREAM_AUTO=

# AI_BACKEND=comfyui: a running ComfyUI.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=
COMFYUI_FAST_LORA=

# AI_BACKEND=runpod: a serverless endpoint (not a pod - pods use the deploy
# script and run this same server).
RUNPOD_ENDPOINT_ID=
RUNPOD_TIMEOUT_MS=300000

# Serve a web build from somewhere other than the packaged one.
WEB_DIST=

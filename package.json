{
  "name": "brushjam",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n python,web -c cyan,magenta \"pnpm start\" \"pnpm --filter @brushjam/web dev\"",
    "dev:lan": "cross-env HOST=0.0.0.0 concurrently -n python,web -c cyan,magenta \"pnpm start\" \"pnpm --filter @brushjam/web dev:host\"",
    "start": "uv run --project apps/brushjam brushjam",
    "build": "pnpm --filter @brushjam/web build && uv run --project apps/brushjam python apps/brushjam/scripts/build_web.py",
    "test": "pnpm -r test",
    "py:test": "uv run --project apps/brushjam pytest -q",
    "typecheck": "pnpm -r typecheck",
    "latency": "pnpm --filter @brushjam/tools latency",
    "playtest-sim": "pnpm --filter @brushjam/tools playtest-sim",
    "smoke": "pnpm --filter @brushjam/tools smoke"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@napi-rs/canvas"
    ]
  },
  "license": "MIT"
}

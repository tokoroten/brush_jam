{
  "name": "brushjam",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"pnpm --filter @brushjam/server dev\" \"pnpm --filter @brushjam/web dev\"",
    "dev:stream": "cross-env AI_BACKEND=stream pnpm dev",
    "dev:lan": "cross-env HOST=0.0.0.0 AI_BACKEND=stream concurrently -n server,web -c cyan,magenta \"pnpm --filter @brushjam/server dev\" \"pnpm --filter @brushjam/web dev:host\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "start": "pnpm --filter @brushjam/server start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@napi-rs/canvas"
    ]
  }
}
